{
  "info": {
    "name": "SIMA MIND Admin API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"googleplay@sima-mind.app\",\n  \"password\": \"g00gleplay$#%1234\"\n}" },
        "url": { "raw": "http://localhost:4000/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "4000", "path": ["api","auth","login"] }
      }
    },
    {
      "name": "Admin Stats",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": { "raw": "http://localhost:4000/api/admin/stats", "protocol": "http", "host": ["localhost"], "port": "4000", "path": ["api","admin","stats"] }
      }
    }
  ]
}
